{
  "name": "cargaflow-tms",
  "version": "0.1.0",
  "private": true,
  "description": "CargaFlow - Plataforma SaaS de gestión, trazabilidad y facturación de transporte de carga terrestre con IA",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "drizzle-kit push --force",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -f data/cargaflow.db* && drizzle-kit push --force && tsx scripts/seed.ts",
    "setup": "mkdir -p data && drizzle-kit push --force && tsx scripts/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
